    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: grab;
    pointer-events: auto;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
  }
  .pet-layer.is-held .pet-avatar { cursor: grabbing; }
  .pet-avatar:focus-visible { outline: 2px solid var(--accent); outline-offset: -4px; }
  .pet-canvas { display: block; width: 80px; height: 80px; }
  .pet-status, .pet-speech {
    position: absolute;
    z-index: 1;
    left: var(--pet-label-x, 40px);
    bottom: 76px;
    max-width: min(230px, calc(100vw - 32px));
    padding: 4px 9px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    color: var(--text);
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.13);
    font: 500 10px/1.35 var(--font-mono);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 4px) scale(0.96);
    transition: opacity 140ms ease, transform 160ms ease;
  }
  .pet-status[data-visible='true'], .pet-speech[data-visible='true'] {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
  }
  .pet-speech { z-index: 2; bottom: 80px; font: 500 11px/1.3 var(--font-body); }
  .pet-status[data-visible='true'] ~ .pet-speech[data-visible='true'] { bottom: 104px; }
  .pet-reaction {
    position: absolute;
    top: 0;
    left: 54px;
    color: #d98a83;
    font-size: 15px;
    opacity: 0;
    pointer-events: none;
  }
  .pet-reaction.is-pop { animation: pet-pop 850ms cubic-bezier(.16,.8,.3,1) both; }
  .pet-hide {
    appearance: none;
    position: absolute;
    z-index: 3;
    top: 4px;
    right: 2px;
    width: 19px;
    height: 19px;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--surface);
    color: var(--muted);
    font: 400 14px/16px var(--font-body);
    cursor: pointer;
    opacity: 0;
    pointer-events: auto;
    transition: opacity 130ms ease, color 130ms ease;
  }
  .pet:hover .pet-hide, .pet-hide:focus-visible { opacity: 1; }
  .pet-layer.is-held .pet-hide { opacity: 0; }
  .pet-hide:hover { color: var(--text); }
  :global(.site-footer .pet-toggle) {
    appearance: none;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    cursor: pointer;
  }
  :global(.site-footer .pet-toggle:hover) { color: var(--accent-text); }

  /* Pretext text flow (src/scripts/text-flow.ts) */
  /* the hoodie olive is dark; lift it a little on the dark theme so it still reads */
  :global([data-theme="dark"]) .pet-canvas { filter: brightness(1.35); }
  :global(.text-flow) { position: relative; transition: height 220ms cubic-bezier(.2,.7,.2,1); }
  :global(.text-flow .flow-lines) { position: absolute; inset: 0 auto auto 0; width: 100%; pointer-events: none; }
  :global(.text-flow .flow-line) { position: absolute; top: 0; left: 0; white-space: pre; will-change: transform; }
  :global(.text-flow .flow-line a) { pointer-events: auto; }
