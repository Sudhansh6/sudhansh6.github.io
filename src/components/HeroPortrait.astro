---
// Home-hero portrait: the real photo with only its alpha shaped (scripts/build-hero-portrait.py).
// The subject stays crisp; the shoreline around him fades out with a soft, irregular edge, so the
// photo dissolves into the page instead of ending at a frame. The dark variant also drops the pale
// overcast sky, which would otherwise glow on the dark page.
---

<div class="hero-portrait">
  <img class="for-light" src="/assets/img/me/portrait.webp" alt="Sudhansh smiling on a rocky shoreline" width="1120" height="1200" fetchpriority="high" />
  <img class="for-dark" src="/assets/img/me/portrait-dark.webp" alt="" aria-hidden="true" width="1120" height="1200" />
</div>

<style>
  .hero-portrait {
    position: absolute; z-index: 0; pointer-events: none;
    left: 58%; top: 52%; width: 500px; height: 536px; transform: translateY(-50%);
    animation: portrait-in 0.9s 0.15s cubic-bezier(0.22, 0.75, 0.24, 1) both;
  }
  .hero-portrait img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .for-dark { display: none; }
  :global([data-theme='dark']) .hero-portrait .for-dark { display: block; }
  :global([data-theme='dark']) .hero-portrait .for-light { visibility: hidden; }
  @keyframes portrait-in { from { opacity: 0; translate: 0 10px; } to { opacity: 1; translate: 0 0; } }
  @media (max-width: 900px) {
    .hero-portrait {
      position: relative; left: auto; top: auto; transform: none;
      width: min(340px, 88%); height: auto; aspect-ratio: 560 / 600; margin: -30px auto -30px;
    }
  }
  @media (prefers-reduced-motion: reduce) { .hero-portrait { animation: none; } }
</style>
