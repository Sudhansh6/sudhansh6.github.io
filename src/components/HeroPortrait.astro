---
// Home-hero portrait: a plain square crop of the original photo (Acadia shoreline), framed as a
// rounded card. One image for both themes; no cut-out or masking.
---

<figure class="hero-portrait">
  <img src="/assets/img/me/portrait-square.webp" alt="Sudhansh smiling on a rocky shoreline" width="960" height="960" fetchpriority="high" />
</figure>

<style>
  .hero-portrait {
    position: absolute; z-index: 0; margin: 0;
    left: 62%; top: 50%; width: 340px; aspect-ratio: 1; transform: translate(28px, -50%);
    border-radius: 22px; overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: 0 18px 50px -18px rgba(0, 0, 0, 0.45), 0 2px 8px rgba(0, 0, 0, 0.08);
    animation: portrait-in 0.9s 0.15s cubic-bezier(0.22, 0.75, 0.24, 1) both;
  }
  .hero-portrait img { display: block; width: 100%; height: 100%; object-fit: cover; }
  :global([data-theme='dark']) .hero-portrait img { filter: brightness(0.92) saturate(0.95); }
  @keyframes portrait-in { from { opacity: 0; translate: 0 10px; } to { opacity: 1; translate: 0 0; } }
  @media (max-width: 1100px) { .hero-portrait { left: 60%; width: 300px; } }
  @media (max-width: 900px) {
    .hero-portrait {
      position: relative; left: auto; top: auto; transform: none;
      width: min(260px, 72%); margin: 0 auto 28px;
    }
  }
  @media (prefers-reduced-motion: reduce) { .hero-portrait { animation: none; } }
</style>
