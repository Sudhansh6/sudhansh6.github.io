<div class="pet-layer" id="site-moss-pet" transition:persist="site-moss-pet" aria-label="Moss, the site pet">
  <div class="pet" id="site-moss-pet-anchor">
    <button class="pet-avatar" id="site-moss-pet-avatar" type="button" aria-label="Say hello to Moss" title="Moss: click, or drag me into the text">
      <canvas class="pet-canvas" id="site-moss-pet-canvas" width="80" height="80" aria-hidden="true"></canvas>
    </button>
    <span class="pet-status" id="site-moss-pet-status" role="status" aria-live="polite"></span>
    <span class="pet-speech" id="site-moss-pet-speech" aria-live="polite"></span>
    <span class="pet-reaction" id="site-moss-pet-reaction" aria-hidden="true">♥</span>
    <button class="pet-hide" id="site-moss-pet-hide" type="button" aria-label="Hide Moss" title="Hide pet (press p to bring back)">×</button>
    <button class="pet-ask-btn" id="site-moss-pet-ask-btn" type="button" aria-label="Ask Moss a question" title="Ask Moss (runs on your device)" hidden>?</button>
    <form class="pet-ask" id="site-moss-pet-ask" hidden>
      <input id="site-moss-pet-ask-input" type="text" maxlength="200" autocomplete="off" spellcheck="false" placeholder="ask the invader…" aria-label="Ask Moss" />
    </form>
  </div>
</div>

<script>
  // Moss: a little 👾 pixel invader that lives at the bottom of the viewport and behaves like a
  // tiny agent. It runs little tasks, does tricks,
  // can be clicked, dragged and thrown, and can sit inside any `[data-text-flow]` paragraph,
  // where Pretext reflows the words around it.
  import { flowTargetAt, scanFlowTargets, setFlowObstacle, visibleFlowTargets } from '../scripts/text-flow';
  import { ask, brainReady, hush, remark } from '../scripts/pet-brain';

  (() => {
    const host = window as any;
    if (!host.__ff?.pet) return; // behind the `pet` feature flag (?pet to enable); see Base.astro
    if (host.__siteMossPetInstalled) return;
    host.__siteMossPetInstalled = true;

    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const layer = $('site-moss-pet');
    const anchor = $('site-moss-pet-anchor');
    const avatar = $('site-moss-pet-avatar') as HTMLButtonElement;
    const canvas = $('site-moss-pet-canvas') as HTMLCanvasElement;
    const status = $('site-moss-pet-status');
    const speech = $('site-moss-pet-speech');
    const reaction = $('site-moss-pet-reaction');
    const hideButton = $('site-moss-pet-hide');
    const ctx = canvas?.getContext('2d');
    if (!layer || !anchor || !avatar || !canvas || !ctx) return;

    const S = 80; // canvas size (CSS px)
    const P = 2.05; // invader pixel size (CSS px)
    const COLS = 20; // 18 × 15 body pixels plus a one-pixel outline all round
    const ROWS = 17;
    const BODY_H = ROWS * P;
    const BODY_DY = 70 - BODY_H / 2 - S / 2; // drawn body centre sits this far below the avatar centre
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const coarsePointer = matchMedia('(pointer: coarse)');
    const clamp = (n: number, a: number, b: number) => Math.max(a, Math.min(b, n));
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const pick = <T,>(xs: T[]) => xs[Math.floor(Math.random() * xs.length)];
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);

    // ---------- 👾 sprite ----------
    // Sampled cell by cell from Apple's 👾 glyph: 18 × 15 body pixels. Claw tips and feet float, and
    // the one-pixel dark outline (every cell touching the body) is what holds them on, as in the
    // emoji. Frame B is the arcade second step: claws drop a row, legs and feet swing out.
    const SHAPES = [
      ['...X..........X...', '......X....X......', '..XX..X....X..XX..', '..X..XXXXXXXX..X..', 'X...XXXXXXXXXX...X',
       'X..XXXXXXXXXXXX..X', 'X..XX..XXXX..XX..X', 'X..XX..XXXX..XX..X', '.XXXX..XXXX..XXXX.', '...XXXXXXXXXXXX...',
       '...XXXXXXXXXXXX...', '.....XX....XX.....', '.....XX....XX.....', '..................', '...X..........X...'],
      ['..................', '...X..X....X..X...', '..X...X....X...X..', '..XX.XXXXXXXX.XX..', 'X...XXXXXXXXXX...X',
       'X..XXXXXXXXXXXX..X', 'X..XX..XXXX..XX..X', 'X..XX..XXXX..XX..X', '.XXXX..XXXX..XXXX.', '...XXXXXXXXXXXX...',
       '...XXXXXXXXXXXX...', '.....XX....XX.....', '....XX......XX....', '..................', '..X............X..'],
    ];
    // Eye holes are 2 × 3 cells (full-grid rows 7–9, cols 6–7 and 12–13); a white bar sits in each.
    const EYE_X = [7, 13];
    const EYE_Y = 8.5;
    const GX = (-COLS / 2) * P; // sprite origin relative to the body centre
    const GY = -BODY_H / 2;
    // Hoodie olive: a lighter top half and darker bottom, as in the emoji's two-tone shading.
    const FUR = ['#20271d', '#2c3628', '#3a4634', '#4f5c46', '#5f6c55']; // dark → light
    const OUTLINE = '#181d16';
    const NUB = '#9aa48a';
    const EYE = { white: '#eef1e6' };

    // Each frame becomes a list of cells: 1 = body, 2 = outline. Body cells get a random fleece shade
    // and, sometimes, a light nub, so the texture never repeats as a pattern. Every cell also gets a
    // random scatter vector for the pixel warp.
    type Cell = { r: number; c: number; kind: 1 | 2; shade: number; nub: [number, number] | null; sx: number; sy: number };
    const FRAMES: Cell[][] = SHAPES.map((rows) => {
      const on = (r: number, c: number) => r >= 1 && r <= 15 && c >= 1 && c <= 18 && rows[r - 1][c - 1] === 'X';
      const cells: Cell[] = [];
      for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) {
        let kind: 0 | 1 | 2 = on(r, c) ? 1 : 0;
        if (!kind) for (let dr = -1; dr <= 1 && !kind; dr++) for (let dc = -1; dc <= 1; dc++) if (on(r + dr, c + dc)) { kind = 2; break; }
        if (!kind) continue;
        const base = r <= 8 ? 3 : 2;
        const shade = kind === 1 ? clamp(base + (Math.random() < 0.3 ? (Math.random() < 0.5 ? -1 : 1) : 0), 1, 4) : 0;
        const nub: [number, number] | null = kind === 1 && Math.random() < 0.3 ? [rand(0.25, 0.75), rand(0.25, 0.75)] : null;
        const a = rand(0, Math.PI * 2);
        const d = rand(14, 34);
        cells.push({ r, c, kind, shade, nub, sx: Math.cos(a) * d, sy: Math.sin(a) * d - 6 });
      }
      return cells;
    });
    // Lint: single fleece pixels shed when it is shaken or thrown (sprite-local coordinates).
    const lint: { x: number; y: number; vx: number; vy: number; life: number; shade: number }[] = [];
    let lastDraw = 0;
    let assembleAt = performance.now(); // it arrives as a cloud of pixels that pulls together

    // ---------- state ----------
    type Mode = 'ground' | 'held' | 'air' | 'jump' | 'perched';
    let mode: Mode = 'ground';
    let task: 'idle' | 'walking' | 'working' | 'returning' = 'idle';
    let width = innerWidth;
    let height = innerHeight;
    let dpr = devicePixelRatio || 1;
    let compact = width <= 640 || coarsePointer.matches;
    let isReduced = reducedMotion.matches;
    const floorY = () => height - 48;
    const minX = () => 48;
    const maxX = () => width - 50;
    const homeX = () => (compact ? width - 50 : clamp(width * 0.16, 60, width - 60));
    let cx = homeX();
    let cy = floorY();
    let targetX = cx;
    let gvx = 0; // ground velocity
    let vx = 0;
    let vy = 0; // air velocity
    let bounceY = 0;
    let bounceV = 0;
    let hopPhase = 0;
    let sq = 0;
    let sqv = 0; // squash spring (positive = squashed)
    let rot = 0;
    let furKick = 0; // extra fur motion
    let pointerX = -1;
    let pointerY = -1;
    let following = false;
    let hovering = false;
    let asleep = false;
    let taskLabel = '';
    let taskKind = 0;
    let taskHome = cx;
    let workUntil = 0;
    const now0 = performance.now();
    let nextTaskAt = now0 + rand(9000, 18000);
    let nextTrickAt = now0 + rand(5000, 11000);
    let trick: { kind: string; t0: number; dur: number; said?: boolean } | null = null;
    let lastActivity = now0;
    let blinkUntil = 0;
    let nextBlinkAt = now0 + rand(2000, 5000);
    let speechUntil = 0;
    let happyUntil = 0;
    let dizzyUntil = 0;
    let combo = 0;
    let lastClickAt = 0;
    let room = 0;
    let roomShown = false;
    // On a paragraph the pet either patrols its top edge ('ledge') or creeps through the lines
    // along a smooth path ('creep'), parting the words around it. dx/dy are paragraph-local.
    type CreepPath = { pts: [number, number][]; segs: number[]; total: number; s: number };
    let perch: {
      el: HTMLElement; kind: 'ledge' | 'creep'; dx: number; dy: number; dir: number;
      until: number; nextCreep: number; pauseUntil: number; path: CreepPath | null;
    } | null = null;
    let jump: { x0: number; y0: number; t0: number; dur: number; to: () => [number, number]; then: () => void; room: boolean; warp?: boolean } | null = null;
    let held: { id: number; ox: number; oy: number; px: number; py: number; vx: number; vy: number; t: number } | null = null;
    let press: { id: number; x: number; y: number; t: number } | null = null;
    let suppressClick = false;
    let lastScrollY = scrollY;
    let lastScrollT = now0;
    let bumpCooldown = 0;
    let petHidden = false;
    let rafId = 0;
    let lastFrame = 0;
    const metrics = { frames: 0, averageFrameCostMs: 0, maxFrameCostMs: 0 };
    const samples: number[] = [];

    // ---------- labels ----------
    function positionLabel(el: HTMLElement) {
      const w = Math.max(48, el.offsetWidth || 48);
      const left = cx - 40;
      const centre = clamp(cx, w / 2 + 8, width - w / 2 - 8);
      el.style.setProperty('--pet-label-x', `${centre - left}px`);
    }
    function say(msg: string, ms = 2100) {
      speech.textContent = msg;
      speech.dataset.long = String(msg.length > 34);
      speech.dataset.visible = 'true';
      positionLabel(speech);
      speechUntil = performance.now() + ms;
    }
    function pop(symbol = '♥') {
      reaction.textContent = symbol;
      reaction.classList.remove('is-pop');
      void reaction.offsetWidth;
      reaction.classList.add('is-pop');
    }
    function updateStatus() {
      let text = '';
      if (asleep) text = 'Zz';
      else if (mode === 'ground' && task !== 'idle') text = taskLabel;
      status.textContent = text;
      status.dataset.visible = text ? 'true' : 'false';
      layer.dataset.state = asleep ? 'sleep' : mode === 'ground' ? task : mode;
      avatar.setAttribute('aria-label', asleep ? 'Wake Moss' : 'Say hello to Moss');
      positionLabel(status);
    }

    const pageHeading = () => (document.querySelector('main h1')?.textContent || '').replace(/\s+/g, ' ').trim();
    function chooseTaskLabel() {
      const path = location.pathname;
      const h = pageHeading();
      const short = (s: string, n: number) => (s.length > n ? `${s.slice(0, n)}…` : `${s}…`);
      if (h && path.startsWith('/writing/') && path !== '/writing/') return `reading ${short(h, 24)}`;
      if (h && path.startsWith('/projects/') && path !== '/projects/') return `exploring ${short(h, 20)}`;
      return pick(['scanning the archives…', 'probing links…', 'retrieving a paper…', 'descending the gradient…', 'recalibrating pixels…', 'consulting the grue…']);
    }

    // ---------- behaviours ----------
    const canRoam = () => !isReduced && !petHidden && !document.hidden && !asleep;

    function startWalk() {
      if (!canRoam() || compact || mode !== 'ground') return;
      task = 'walking';
      taskLabel = chooseTaskLabel();
      taskKind = (taskKind + 1) % 3;
      taskHome = cx;
      let dest = rand(minX() + 20, maxX() - 20);
      if (Math.abs(dest - cx) < Math.min(140, width * 0.22)) dest = dest < width / 2 ? maxX() - 20 : minX() + 20;
      targetX = dest;
      updateStatus();
    }

    // warp: instead of an arc, it scatters into pixels, vanishes and pulls itself together at the target
    function jumpTo(to: () => [number, number], then: () => void, intoText = false, dur = 760, warp = false) {
      jump = { x0: cx, y0: cy, t0: performance.now(), dur, to, then, room: intoText, warp: warp && !isReduced };
      mode = 'jump';
      task = 'idle';
      trick = null;
      sqv -= 6; // crouch-and-spring
      updateStatus();
    }

    function settleOnGround() {
      mode = 'ground';
      task = 'idle';
      cy = floorY();
      targetX = cx;
      gvx = 0;
      perch = null;
      updateStatus();
    }

    const FEET = 30; // feet sit this far below the avatar centre
    const LEDGE_DY = -FEET + 6; // stand on the first line's glyph tops, not its line box
    const lineHeightOf = (el: HTMLElement) => {
      const cs = getComputedStyle(el);
      return parseFloat(cs.lineHeight) || parseFloat(cs.fontSize) * 1.6;
    };

    function creepPath(el: HTMLElement, x0: number, y0: number): CreepPath {
      const r = el.getBoundingClientRect();
      const lh = lineHeightOf(el);
      const inY = (v: number) => clamp(v, lh * 0.55, Math.max(lh * 0.55, r.height - lh * 0.55));
      const inX = (v: number) => clamp(v, 30, r.width - 30);
      let dir = Math.random() < 0.5 ? -1 : 1;
      let x = inX(x0);
      const pts: [number, number][] = [[x0, y0]];
      if (y0 < 0) pts.push([inX(x + dir * 26), inY(lh * 0.6)]); // dive in from the top edge
      const n = 2 + Math.floor(Math.random() * 2);
      for (let i = 0; i < n; i++) {
        x = inX(x + dir * rand(70, 170));
        if (x <= 31 || x >= r.width - 31) dir = -dir;
        pts.push([x, inY(rand(lh * 0.6, r.height - lh * 0.6))]);
      }
      const xe = inX(x + dir * 30);
      pts.push([xe, inY(lh * 0.5)], [xe, LEDGE_DY]); // climb back out on top
      const segs = pts.slice(1).map((q, i) => Math.hypot(q[0] - pts[i][0], q[1] - pts[i][1]));
      return { pts, segs, total: segs.reduce((a, b) => a + b, 0), s: 0 };
    }

    function pathAt(p: CreepPath): [number, number] {
      let i = 0;
      let acc = 0;
      while (i < p.segs.length - 1 && acc + p.segs[i] < p.s) { acc += p.segs[i]; i++; }
      const t = clamp((p.s - acc) / (p.segs[i] || 1), 0, 1);
      const P = p.pts;
      const a = P[Math.max(0, i - 1)], b = P[i], c = P[i + 1], d = P[Math.min(P.length - 1, i + 2)];
      const cr = (k: 0 | 1) => 0.5 * (2 * b[k] + (-a[k] + c[k]) * t + (2 * a[k] - 5 * b[k] + 4 * c[k] - d[k]) * t * t + (-a[k] + 3 * b[k] - 3 * c[k] + d[k]) * t * t * t);
      return [cr(0), cr(1)];
    }

    function perchOn(el: HTMLElement, x: number, y: number, kind: 'ledge' | 'creep' = 'ledge') {
      const r = el.getBoundingClientRect();
      const now = performance.now();
      const dx = clamp(x - r.left, 26, Math.max(26, r.width - 26));
      const dy = kind === 'ledge' ? LEDGE_DY : y - r.top;
      perch = {
        el, kind, dx, dy, dir: Math.random() < 0.5 ? -1 : 1,
        until: now + rand(22000, 40000), nextCreep: now + rand(3500, 8000), pauseUntil: 0,
        path: kind === 'creep' ? creepPath(el, dx, dy) : null,
      };
      mode = 'perched';
      task = 'idle';
      updateStatus();
    }

    // Standing on a paragraph puts the body in the gap above it. That is fine below more prose (it
    // parts) or open space, but not tucked under a heading or figure that cannot move out of the way.
    const hasHeadroom = (el: HTMLElement) => {
      const prev = el.previousElementSibling as HTMLElement | null;
      if (!prev || prev.tagName === 'P') return true;
      return el.getBoundingClientRect().top - prev.getBoundingClientRect().bottom > 38;
    };

    function hopIntoText() {
      const targets = visibleFlowTargets().filter(hasHeadroom);
      if (!targets.length) return false;
      const el = pick(targets);
      const r = el.getBoundingClientRect();
      const dx = rand(70, r.width - 70);
      jumpTo(() => { const q = el.getBoundingClientRect(); return [q.left + dx, q.top + LEDGE_DY]; }, () => {
        const q = el.getBoundingClientRect();
        perchOn(el, q.left + dx, q.top + LEDGE_DY, 'ledge');
        if (!tryRemark(el)) say(pick(['you are standing on a paragraph.', 'there is a word here.', 'sector acquired', 'patrolling.']));
      }, false, 820, Math.random() < 0.45);
      return true;
    }

    function hopDown() {
      const x = clamp(cx + rand(-160, 160), minX(), maxX());
      perch = null;
      jumpTo(() => [x, floorY()], () => { settleOnGround(); say(pick(['you leave the paragraph.', '>JUMP', 'exit: down'])); }, false, 700);
    }

    function startTrick(kind?: string) {
      const kinds = compact ? ['spin', 'hophop', 'wiggle'] : ['spin', 'hophop', 'wiggle', 'peek', 'spin', 'hophop'];
      const k = kind || pick(kinds);
      const dur = { spin: 900, flip: 760, hophop: 1500, wiggle: 900, peek: 2700 }[k] || 900;
      trick = { kind: k, t0: performance.now(), dur };
      if (k === 'spin') bounceV = -270;
      if (k === 'flip') bounceV = -340;
      if (k === 'wiggle') furKick = 1;
    }

    function wake() {
      lastActivity = performance.now();
      if (asleep) {
        asleep = false;
        sqv -= 4;
        say(pick(['it is pitch black. oh. hi.', '*rebooting*', 'i was not dormant']));
        nextTaskAt = lastActivity + rand(9000, 18000);
        updateStatus();
      }
    }

    function handleClick() {
      wake();
      const now = performance.now();
      combo = now - lastClickAt < 520 ? combo + 1 : 1;
      lastClickAt = now;
      happyUntil = now + 1300;
      if (mode === 'ground' && !trick) bounceV = -170;
      sqv -= 5;
      furKick = 1;
      if (combo >= 5) {
        dizzyUntil = now + 2300;
        combo = 0;
        pop('✦');
        say('twisty little passages…');
      } else if (combo === 3) {
        if (mode === 'ground') startTrick('flip');
        pop('✦');
        say('>THROW PET');
      } else if (combo === 1) {
        pop('♥');
        say(pick(['>HELLO', 'greetings, reader.', 'zork.', 'take me to your reader', 'drag me into the text.']));
      }
    }

    function hidePet(hidden: boolean) {
      petHidden = hidden;
      if (hidden) { hush(); askForm.hidden = true; }
      layer.hidden = hidden;
      try { localStorage.setItem('pet:hidden', hidden ? 'true' : 'false'); } catch {}
      document.querySelectorAll('[data-pet-toggle]').forEach((b) => {
        b.setAttribute('aria-pressed', String(!hidden));
        b.setAttribute('aria-label', hidden ? 'Show the pet' : 'Hide the pet');
      });
      if (hidden) { setFlowObstacle(null); roomShown = false; room = 0; perch = null; if (mode !== 'ground') settleOnGround(); }
      else { wake(); startLoop(); }
    }

    // ---------- simulation ----------
    function update(now: number, dtMs: number) {
      const dt = dtMs / 1000;
      if (now >= nextBlinkAt) { blinkUntil = now + 130; nextBlinkAt = now + rand(2400, 6000); }
      if (speechUntil && now >= speechUntil) { speech.dataset.visible = 'false'; speechUntil = 0; }
      if (!asleep && now - lastActivity > 60000 && mode !== 'held' && mode !== 'air' && mode !== 'jump') {
        asleep = true; task = 'idle'; trick = null; targetX = cx; updateStatus();
      }
      furKick = Math.max(0, furKick - dt * 1.6);

      // squash spring
      sqv += (-sq * 320 - sqv * 15) * dt;
      sq += sqv * dt;

      if (mode === 'held' && held) {
        const k = 1 - Math.exp(-dt * 32);
        const tx = held.px + held.ox;
        const ty = held.py + held.oy;
        cx += (tx - cx) * k;
        cy += (ty - cy) * k;
        rot += (clamp(held.vx * 0.00045, -0.55, 0.55) - rot) * (1 - Math.exp(-dt * 10));
        furKick = Math.max(furKick, 0.6);
      } else if (mode === 'air') {
        vy += 2300 * dt;
        cx += vx * dt;
        cy += vy * dt;
        rot *= Math.exp(-dt * 6);
        if (cx < minX()) { cx = minX(); vx = Math.abs(vx) * 0.5; sqv += 3; }
        if (cx > maxX()) { cx = maxX(); vx = -Math.abs(vx) * 0.5; sqv += 3; }
        if (cy < 40) { cy = 40; vy = Math.abs(vy) * 0.3; }
        if (cy >= floorY()) {
          cy = floorY();
          if (vy > 340 && !isReduced) {
            sqv += Math.min(14, vy / 120);
            vy = -vy * 0.36;
            vx *= 0.72;
            furKick = 1;
          } else {
            const hard = Math.abs(vx) > 500;
            settleOnGround();
            if (hard) say(pick(['>AGAIN', 'oof.', 'landing: nominal']));
          }
        }
      } else if (mode === 'jump' && jump) {
        const t = clamp((now - jump.t0) / jump.dur, 0, 1);
        const [x1, y1] = jump.to();
        if (jump.warp) {
          // hold still while scattering, then reappear at the target mid-cloud
          const there = t >= 0.45;
          cx = there ? x1 : jump.x0;
          cy = there ? y1 : jump.y0;
          rot = 0;
        } else {
          const lift = Math.max(70, (jump.y0 - y1) * 0.28 + 70);
          cx = jump.x0 + (x1 - jump.x0) * ease(t);
          cy = jump.y0 + (y1 - jump.y0) * t - lift * 4 * t * (1 - t);
          rot = Math.sin(t * Math.PI) * 0.25 * Math.sign(x1 - jump.x0);
        }
        if (t >= 1) {
          const done = jump.then;
          jump = null;
          rot = 0;
          sqv += 9;
          furKick = 1;
          done();
        }
      } else if (mode === 'perched' && perch) {
        if (!perch.el.isConnected) { perch = null; mode = 'air'; vx = 0; vy = 0; }
        else {
          const r = perch.el.getBoundingClientRect();
          if (perch.kind === 'ledge') {
            // patrol the top edge, pausing now and then, and turn at the ends
            const walking = !asleep && !isReduced && now > perch.pauseUntil;
            gvx = walking ? perch.dir * 24 : 0;
            if (walking) {
              perch.dx += perch.dir * 24 * dt;
              if (Math.random() < dt * 0.25) perch.pauseUntil = now + rand(700, 1800);
            }
            if (perch.dx < 26 || perch.dx > r.width - 26) { perch.dir = perch.dx < 26 ? 1 : -1; perch.dx = clamp(perch.dx, 26, r.width - 26); }
            perch.dy = LEDGE_DY;
            rot *= Math.exp(-dt * 6);
            if (!asleep && !isReduced && now > perch.nextCreep && r.height > 40) {
              perch.kind = 'creep';
              perch.path = creepPath(perch.el, perch.dx, perch.dy);
              say(pick(['descending.', 'going in.', 'you enter the paragraph.']), 1500);
            }
          } else if (perch.path) {
            // creep through the lines; the words part around the body
            gvx = 0;
            if (!asleep && !isReduced) perch.path.s += 30 * dt;
            [perch.dx, perch.dy] = pathAt(perch.path);
            rot = Math.sin(now / 190) * 0.07;
            if (perch.path.s >= perch.path.total) {
              perch.kind = 'ledge';
              perch.path = null;
              perch.dy = LEDGE_DY;
              perch.nextCreep = now + rand(6000, 14000);
              sqv += 4;
              say(pick(['you emerge.', 'surfaced.', 'words: inspected']), 1500);
            }
          }
          cx = r.left + perch.dx;
          cy = r.top + perch.dy;
          if (cy < 70 || cy > height - 40) { perch = null; mode = 'air'; vx = 0; vy = 0; say('whoa.'); }
          else if (!asleep && !isReduced && now > perch.until) hopDown();
        }
      } else {
        // ground
        cy = floorY();
        if (asleep || isReduced) targetX = compact ? homeX() : cx;
        else if (compact) targetX = homeX();
        else if (task === 'idle' && following) targetX = clamp(pointerX, minX(), maxX());

        if (task === 'walking' && Math.abs(targetX - cx) < 3 && Math.abs(gvx) < 6) {
          task = 'working'; workUntil = now + rand(2600, 4400); updateStatus();
        } else if (task === 'working' && now >= workUntil) {
          task = 'returning'; targetX = compact ? homeX() : taskHome; updateStatus();
        } else if (task === 'returning' && Math.abs(targetX - cx) < 3 && Math.abs(gvx) < 6) {
          task = 'idle'; taskLabel = ''; nextTaskAt = now + rand(12000, 26000); updateStatus();
        }

        if (task === 'idle' && !trick && canRoam()) {
          if (now >= nextTaskAt) {
            nextTaskAt = now + rand(12000, 26000);
            if (compact || !(Math.random() < 0.5 && hopIntoText())) startWalk();
          } else if (now >= nextTrickAt) {
            nextTrickAt = now + rand(7000, 15000);
            startTrick();
          }
        }

        const acc = (targetX - cx) * 26 - gvx * 9.5;
        gvx += acc * dt;
        cx += gvx * dt;
        cx = clamp(cx, minX(), maxX());
        const moving = Math.abs(gvx) > 14 && !isReduced;
        hopPhase = moving ? hopPhase + dt * 13 : 0;
        if (moving && Math.abs(Math.sin(hopPhase)) < 0.12) sqv += 0.6;

        // click / trick bounces
        bounceV += 1500 * dt;
        bounceY += bounceV * dt;
        if (bounceY > 0) {
          if (bounceV > 220) sqv += Math.min(8, bounceV / 70);
          bounceY = 0;
          bounceV = 0;
        }
        let trickY = 0;
        if (trick) {
          const t = clamp((now - trick.t0) / trick.dur, 0, 1);
          if (trick.kind === 'spin') rot = Math.PI * 2 * ease(t);
          else if (trick.kind === 'flip') rot = -Math.PI * 2 * ease(t);
          else if (trick.kind === 'wiggle') rot = Math.sin(t * 46) * 0.14 * (1 - t);
          else if (trick.kind === 'hophop' && bounceY === 0 && t < 0.85) bounceV = -190;
          else if (trick.kind === 'peek') {
            trickY = t < 0.22 ? 52 * ease(t / 0.22) : t < 0.6 ? 52 : t < 0.7 ? 52 - 62 * ease((t - 0.6) / 0.1) : -10 * (1 - ease((t - 0.7) / 0.3));
            if (t > 0.62 && !trick.said) { trick.said = true; say('grue!'); sqv -= 6; }
          }
          if (t >= 1) { trick = null; rot = 0; }
        } else rot *= Math.exp(-dt * 8);
        cy = floorY() + bounceY + trickY - (moving ? Math.abs(Math.sin(hopPhase)) * 6 : 0);
      }

      // text room: grows while the pet sits in (or is held over, or is landing in) a paragraph
      const creeping = mode === 'perched' && perch?.kind === 'creep';
      const wantRoom =
        mode === 'perched' ||
        (mode === 'held' && !!flowTargetAt(cx, cy)) ||
        (mode === 'jump' && !!jump?.room && now - jump.t0 > jump.dur * 0.5);
      room += ((wantRoom ? 1 : 0) - room) * (1 - Math.exp(-dt * (wantRoom ? 9 : 12)));
      // On the ledge only the paragraph above can be in the way, so the one underfoot is skipped.
      const skip = mode === 'perched' && perch?.kind === 'ledge' ? perch.el : null;
      if (room > 0.03) { setFlowObstacle({ x: cx, y: cy + BODY_DY, r: (creeping ? 26 : 22) * room }, skip); roomShown = true; }
      else if (roomShown) { setFlowObstacle(null); roomShown = false; }

      anchor.style.setProperty('--pet-x', `${(cx - 40).toFixed(2)}px`);
      anchor.style.setProperty('--pet-y', `${(cy - floorY()).toFixed(2)}px`);
      if (status.dataset.visible === 'true') positionLabel(status);
      if (speech.dataset.visible === 'true') positionLabel(speech);
    }

    // ---------- drawing ----------
    function draw(now: number) {
      const t = now / 1000;
      ctx!.clearRect(0, 0, S, S);
      const airborne = mode === 'air' || mode === 'jump' || mode === 'held';
      const moving = (mode === 'ground' || (mode === 'perched' && perch?.kind === 'ledge')) && Math.abs(gvx) > 14 && !isReduced;
      const happy = now < happyUntil;
      const dizzy = now < dizzyUntil;
      const blink = now < blinkUntil && !airborne;
      const breath = asleep ? Math.sin(t * 1.5) * 0.025 : Math.sin(t * 2.2) * 0.008;

      // shadow on the floor (or on the text when perched)
      const above = mode === 'perched' ? (perch?.kind === 'creep' ? 99 : 0) : Math.max(0, floorY() - cy);
      if (above < 40) {
        const k = 1 - above / 40;
        ctx!.fillStyle = `rgba(0,0,0,${(0.2 * k).toFixed(3)})`;
        ctx!.beginPath();
        ctx!.ellipse(40, 73, 17 * (0.6 + 0.4 * k), 3.2 * k + 0.5, 0, 0, Math.PI * 2);
        ctx!.fill();
      }

      // squash & stretch, pivoting on the feet
      let s = sq;
      if (mode === 'air') s -= clamp(Math.hypot(vx, vy) / 4200, 0, 0.18);
      if (mode === 'held') s -= 0.08;
      s = clamp(s, -0.25, 0.32);
      const sx = 1 + s * 0.85 + breath;
      const sy = 1 - s + breath;

      ctx!.save();
      ctx!.translate(40, 70);
      ctx!.scale(sx, sy);
      ctx!.translate(0, -BODY_H / 2);
      ctx!.rotate(rot + (hovering && !airborne ? Math.sin(t * 13) * 0.04 : 0));

      // marching frame: the arcade two-step, faster on the move and frantic when held
      const rate = isReduced ? (moving ? 4 : 0) : mode === 'held' || happy ? 9 : moving ? 6 : airborne ? 5 : asleep ? 0.4 : 1.4;
      const frameIdx = Math.floor(t * rate) % 2;
      const cells = FRAMES[frameIdx];
      const x0 = GX;
      // walking bobs the whole sprite by one pixel on the second step
      const y0 = GY - (moving && frameIdx === 1 ? P * 0.5 : 0);
      const creeping = mode === 'perched' && perch?.kind === 'creep' && !isReduced;
      // row offsets: a scanline glitch when poked or thrown, a slither while creeping through text
      const glitch = isReduced ? 0 : furKick;
      const rowDx = (r: number) =>
        (glitch > 0.2 ? Math.round(Math.sin(t * 47 + r * 2.3) * glitch * 1.6) : 0) +
        (creeping ? Math.round(Math.sin(t * 7 - r * 0.6) * 2) / 2 : 0);

      // pixel warp: 0 = assembled, 1 = fully scattered
      let scatter = 0;
      if (!isReduced) {
        if (jump?.warp) {
          const k = clamp((now - jump.t0) / jump.dur, 0, 1);
          scatter = k < 0.45 ? ease(k / 0.45) : 1 - ease((k - 0.45) / 0.55);
        } else if (now - assembleAt < 750) scatter = 1 - ease((now - assembleAt) / 750);
      }

      const cellXY = (k: Cell): [number, number] => {
        let x = x0 + k.c * P + rowDx(k.r);
        let y = y0 + k.r * P;
        if (dizzy && !isReduced) { x += Math.round(Math.sin(t * 31 + k.r * 7 + k.c * 13)); y += Math.round(Math.sin(t * 29 + k.c * 5 + k.r * 3)) * 0.5; }
        if (scatter > 0) {
          // stagger by row so it pours together from the top down
          const sk = clamp(scatter * 1.25 - (k.r / ROWS) * 0.25, 0, 1);
          x += k.sx * sk;
          y += k.sy * sk;
        }
        return [x, y];
      };

      if (scatter > 0) ctx!.globalAlpha = 1 - scatter * 0.55;
      // outline first, then body pixels batched by shade; slightly oversized so seams never show
      ctx!.fillStyle = OUTLINE;
      ctx!.beginPath();
      for (const k of cells) if (k.kind === 2) { const [x, y] = cellXY(k); ctx!.rect(x - 0.15, y - 0.15, P + 0.3, P + 0.3); }
      ctx!.fill();
      for (let g = 1; g <= 4; g++) {
        ctx!.fillStyle = FUR[g];
        ctx!.beginPath();
        for (const k of cells) if (k.kind === 1 && k.shade === g) { const [x, y] = cellXY(k); ctx!.rect(x - 0.15, y - 0.15, P + 0.3, P + 0.3); }
        ctx!.fill();
      }
      // fleece nubs: soft light flecks on some pixels
      ctx!.fillStyle = NUB;
      ctx!.globalAlpha *= 0.3;
      ctx!.beginPath();
      for (const k of cells) if (k.nub) { const [x, y] = cellXY(k); ctx!.rect(x + k.nub[0] * P - 0.5, y + k.nub[1] * P - 0.5, 1, 1); }
      ctx!.fill();
      ctx!.globalAlpha = scatter > 0 ? 1 - scatter * 0.55 : 1;

      // eyes: white vertical bars in the 2 × 3 holes. They step a whole pixel toward the pointer,
      // shut to a sliver to blink or sleep, stretch when startled and squint when pleased.
      let lx = 0;
      let ly = 0;
      if (pointerX >= 0 && !dizzy) {
        const dx = pointerX - cx;
        const dy = pointerY - cy;
        if (Math.hypot(dx, dy) < 520) { lx = clamp(dx / 90, -1, 1); ly = clamp(dy / 90, -1, 1); }
      } else if (moving) lx = Math.sign(gvx);
      const wide = airborne || dizzy;
      if (scatter < 0.5) {
        ctx!.fillStyle = EYE.white;
        const w = P * 1.05;
        const h = asleep || blink ? P * 0.45 : wide ? P * 2.7 : happy ? P * 1.3 : P * 2.2;
        for (const col of EYE_X) {
          const ex = x0 + col * P + rowDx(8) + Math.round(lx) * P * 0.45;
          const ey = y0 + EYE_Y * P + Math.round(ly) * P * 0.3 + (asleep || blink ? P * 0.6 : 0);
          ctx!.fillRect(ex - w / 2, ey - h / 2, w, h);
        }
      }
      ctx!.globalAlpha = 1;

      // shed lint when shaken, thrown or pleased; it drifts down and fades
      const fdt = lastDraw ? Math.min(0.05, (now - lastDraw) / 1000) : 0;
      lastDraw = now;
      if (!isReduced && lint.length < 14 && Math.random() < furKick * 0.35 + (moving ? 0.01 : 0)) {
        const k = pick(cells.filter((q) => q.kind === 1));
        lint.push({ x: x0 + (k.c + 0.5) * P, y: y0 + (k.r + 0.5) * P, vx: rand(-14, 14), vy: rand(-18, 4), life: 1, shade: k.shade });
      }
      for (let i = lint.length - 1; i >= 0; i--) {
        const q = lint[i];
        q.vy += 60 * fdt;
        q.x += q.vx * fdt;
        q.y += q.vy * fdt;
        q.life -= fdt * 1.4;
        if (q.life <= 0) { lint.splice(i, 1); continue; }
        ctx!.globalAlpha = q.life;
        ctx!.fillStyle = FUR[q.shade];
        ctx!.fillRect(Math.round(q.x * 2) / 2, Math.round(q.y * 2) / 2, P * 0.6, P * 0.6);
      }
      ctx!.globalAlpha = 1;
      ctx!.restore();

      if (mode === 'ground' && task === 'working') drawTaskMark(t);
      if (asleep) {
        ctx!.fillStyle = NUB;
        ctx!.font = '600 11px system-ui, sans-serif';
        ctx!.fillText('z', 58, 16 + Math.sin(t * 1.2) * 1.2);
        ctx!.font = '600 8px system-ui, sans-serif';
        ctx!.fillText('z', 66, 10 + Math.sin(t * 1.2 + 1) * 1.2);
      }
    }

    function drawTaskMark(t: number) {
      ctx!.save();
      ctx!.lineWidth = 1.6;
      ctx!.lineCap = 'round';
      ctx!.strokeStyle = NUB;
      ctx!.fillStyle = NUB;
      if (taskKind === 0) {
        ctx!.beginPath();
        ctx!.arc(62, 16, 5.2, 0, Math.PI * 2);
        ctx!.moveTo(66, 20);
        ctx!.lineTo(71, 25);
        ctx!.stroke();
      } else if (taskKind === 1) {
        // a blinking terminal cursor: it is typing something
        if (Math.sin(t * 6) > -0.2) ctx!.fillRect(60, 10, 5, 9);
      } else {
        for (let i = 0; i < 3; i++) {
          const a = t * 5 + (i * Math.PI * 2) / 3;
          ctx!.globalAlpha = 0.42 + i * 0.22;
          ctx!.beginPath();
          ctx!.arc(63 + Math.cos(a) * 5, 16 + Math.sin(a) * 5, 1.5, 0, Math.PI * 2);
          ctx!.fill();
        }
      }
      ctx!.restore();
    }

    function frame(now: number) {
      rafId = 0;
      if (document.hidden || petHidden) return;
      const c0 = performance.now();
      // fixed substeps keep the physics frame-rate independent (slow devices, throttled tabs)
      let elapsed = Math.min(lastFrame ? now - lastFrame : 16.7, 120);
      while (elapsed > 0.5) { const step = Math.min(elapsed, 1000 / 60); update(now - elapsed + step, step); elapsed -= step; }
      lastFrame = now;
      draw(now);
      const cost = performance.now() - c0;
      samples.push(cost);
      if (samples.length > 120) samples.shift();
      metrics.frames++;
      metrics.averageFrameCostMs = samples.reduce((a, b) => a + b, 0) / samples.length;
      metrics.maxFrameCostMs = Math.max(metrics.maxFrameCostMs, cost);
      rafId = requestAnimationFrame(frame);
    }
    function startLoop() {
      if (!rafId && !document.hidden && !petHidden) { lastFrame = 0; rafId = requestAnimationFrame(frame); }
    }

    function resize() {
      width = innerWidth;
      height = innerHeight;
      dpr = devicePixelRatio || 1;
      compact = width <= 640 || coarsePointer.matches;
      canvas.width = Math.round(S * dpr);
      canvas.height = Math.round(S * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      cx = clamp(cx, minX(), maxX());
      targetX = compact ? homeX() : clamp(targetX, minX(), maxX());
      if (mode === 'ground') cy = floorY();
    }

    // ---------- input ----------
    avatar.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      press = { id: e.pointerId, x: e.clientX, y: e.clientY, t: performance.now() };
      try { avatar.setPointerCapture(e.pointerId); } catch {}
    });
    avatar.addEventListener('pointermove', (e) => {
      if (held && e.pointerId === held.id) {
        const now = performance.now();
        const dt = Math.max(1, now - held.t) / 1000;
        held.vx = held.vx * 0.4 + ((e.clientX - held.px) / dt) * 0.6;
        held.vy = held.vy * 0.4 + ((e.clientY - held.py) / dt) * 0.6;
        held.px = e.clientX;
        held.py = e.clientY;
        held.t = now;
        return;
      }
      if (press && e.pointerId === press.id && Math.hypot(e.clientX - press.x, e.clientY - press.y) > 5) {
        wake();
        // Grab offset from where the press began, so the pet stays under the finger.
        held = { id: e.pointerId, ox: cx - press.x, oy: cy - press.y, px: e.clientX, py: e.clientY, vx: 0, vy: 0, t: performance.now() };
        press = null;
        mode = 'held';
        task = 'idle';
        trick = null;
        jump = null;
        perch = null;
        bounceY = 0;
        bounceV = 0;
        layer.classList.add('is-held');
        updateStatus();
        say(pick(['>TAKE PET', 'unhand me', 'altitude rising', 'where to, human?']), 1400);
      }
    });
    function release(e: PointerEvent) {
      if (press && e.pointerId === press.id) press = null;
      if (!held || e.pointerId !== held.id) return;
      // Velocity is only sampled on pointermove, so fade it once the pointer has stopped:
      // a drag that pauses before release is a drop, not a throw.
      const decay = Math.exp(-(performance.now() - held.t) / 60);
      const throwVx = clamp(held.vx * decay, -2600, 2600);
      const throwVy = clamp(held.vy * decay, -2600, 2600);
      // Judge the drop where the pointer put the pet, not where the smoothed body has caught up to.
      const dropX = held.px + held.ox;
      const dropY = held.py + held.oy;
      held = null;
      suppressClick = true;
      setTimeout(() => { suppressClick = false; }, 0);
      layer.classList.remove('is-held');
      const target = flowTargetAt(dropX, dropY);
      if (target && Math.hypot(throwVx, throwVy) < 2200) {
        cx = dropX;
        cy = dropY;
        perchOn(target, cx, cy, 'creep');
        sqv += 7;
        say(pick(['you are in a paragraph.', 'excuse me, words', 'this sector is mine', 'reading. slowly.']));
      } else if (isReduced) {
        settleOnGround();
      } else {
        mode = 'air';
        vx = throwVx * 0.9;
        vy = throwVy * 0.9;
        updateStatus();
      }
    }
    avatar.addEventListener('pointerup', release);
    avatar.addEventListener('pointercancel', release);
    // ---------- brain: the browser's own on-device model, when it is already there ----------
    const askBtn = $('site-moss-pet-ask-btn');
    const askForm = $('site-moss-pet-ask') as HTMLFormElement;
    const askInput = $('site-moss-pet-ask-input') as HTMLInputElement;
    let brain = false;
    let nextRemarkAt = 0;
    const readMs = (t: string) => clamp(1800 + t.length * 55, 2600, 9000);
    brainReady().then((ok) => { brain = ok; askBtn.hidden = !ok; });

    // A remark about the paragraph it just landed on; at most one every 45 s.
    function tryRemark(el: HTMLElement) {
      const now = performance.now();
      if (!brain || document.hidden || now < nextRemarkAt) return false;
      nextRemarkAt = now + 45000;
      say('…', 8000);
      remark(el.textContent ?? '', (t) => say(t, 60000))
        .then((t) => (t ? say(t, readMs(t)) : say('there is a word here.')))
        .catch(() => say('there is a word here.'));
      return true;
    }

    function openAsk() {
      if (!brain) return;
      wake();
      askForm.hidden = false;
      askInput.value = '';
      askInput.focus();
    }
    askBtn.addEventListener('click', (e) => { e.stopPropagation(); openAsk(); });
    askForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = askInput.value.trim();
      askForm.hidden = true;
      if (!q) return;
      wake();
      say('…', 30000);
      ask(q, (t) => { wake(); say(t, 60000); })
        .then((t) => say(t || 'you hear nothing.', readMs(t)))
        .catch(() => say('the void does not answer.', 2600));
    });
    askInput.addEventListener('keydown', (e) => { if (e.key === 'Escape') { askForm.hidden = true; askBtn.focus(); } });
    askInput.addEventListener('blur', () => setTimeout(() => { if (document.activeElement !== askInput) askForm.hidden = true; }, 150));

    avatar.addEventListener('click', (e) => {
      e.stopPropagation();
      if (suppressClick) { suppressClick = false; return; }
      handleClick();
    });
    avatar.addEventListener('pointerenter', () => { hovering = true; furKick = Math.max(furKick, 0.5); wake(); });
    avatar.addEventListener('pointerleave', () => { hovering = false; });
    hideButton.addEventListener('click', (e) => { e.stopPropagation(); hidePet(true); });

    document.addEventListener('click', (e) => {
      if ((e.target as Element)?.closest?.('[data-pet-toggle]')) { e.preventDefault(); hidePet(!petHidden); }
    });
    document.addEventListener('keydown', (e) => {
      const el = e.target as HTMLElement;
      const typing = el?.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el?.tagName || '');
      if (!typing && e.key.toLowerCase() === 'p' && !e.metaKey && !e.ctrlKey && !e.altKey) hidePet(!petHidden);
      wake();
    });
    document.addEventListener('pointermove', (e) => {
      wake();
      if (e.pointerType === 'touch') return;
      pointerX = e.clientX;
      pointerY = e.clientY;
      following = !compact && e.clientY > height - 230 && !(e.target as Element)?.closest?.('#site-moss-pet');
    }, { passive: true });
    document.addEventListener('pointerleave', () => { pointerX = -1; following = false; });
    ['pointerdown', 'touchstart'].forEach((n) => document.addEventListener(n, wake, { passive: true }));
    addEventListener('scroll', () => {
      wake();
      const now = performance.now();
      const speed = Math.abs(scrollY - lastScrollY) / Math.max(16, now - lastScrollT) * 1000;
      lastScrollY = scrollY;
      lastScrollT = now;
      if (speed > 2600 && mode === 'ground' && !trick && now > bumpCooldown && !isReduced) {
        bumpCooldown = now + 5000;
        bounceV = -230;
        furKick = 1;
        if (Math.random() < 0.45) say(pick(['velocity: excessive', 'whoa.', 'slow down, human']), 1300);
      }
    }, { passive: true });

    document.addEventListener('astro:before-swap', () => { setFlowObstacle(null); roomShown = false; room = 0; });
    document.addEventListener('astro:page-load', () => {
      scanFlowTargets();
      if (mode === 'perched' && perch && !perch.el.isConnected) { perch = null; mode = 'air'; vx = 0; vy = 0; }
      if (mode === 'ground' && task !== 'idle' && /^\/(writing|projects)\/./.test(location.pathname)) {
        taskLabel = chooseTaskLabel();
        updateStatus();
      }
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { if (rafId) cancelAnimationFrame(rafId); rafId = 0; }
      else startLoop();
    });
    addEventListener('resize', resize, { passive: true });
    reducedMotion.addEventListener?.('change', (e) => { isReduced = e.matches; });
    coarsePointer.addEventListener?.('change', resize);

    try { petHidden = localStorage.getItem('pet:hidden') === 'true'; } catch {}
    layer.hidden = petHidden;
    document.querySelectorAll('[data-pet-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(!petHidden)));
    scanFlowTargets();
    resize();
    updateStatus();
    startLoop();

    if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') {
      host.__petDebug = {
        metrics,
        click: handleClick,
        trick: startTrick,
        hopIntoText,
        hopDown,
        walk: startWalk,
        sleep() { asleep = true; updateStatus(); },
        place(x: number, y: number, kind: 'ledge' | 'creep' = 'creep') { const el = flowTargetAt(x, y); cx = x; cy = y; if (el) perchOn(el, x, y, kind); },
        get state() { return { mode, task, asleep, cx, cy, room }; },
      };
    }
  })();
</script>

<style>
  .pet-layer {
    position: fixed;
    inset: 0;
    z-index: 40;
    pointer-events: none;
    overflow: visible;
  }
  .pet-layer[hidden] { display: none !important; }
  :global(html:not([data-ff-pet])) .pet-layer, :global(html:not([data-ff-pet]) .footer-pet) { display: none !important; }
  :global(.footer-pet) { display: inline-flex; gap: 0.45em; }
  .pet {
    position: absolute;
    left: 0;
    bottom: 8px;
    width: 80px;
    height: 80px;
    transform: translate3d(var(--pet-x, 40px), var(--pet-y, 0), 0);
    will-change: transform;
    pointer-events: none;
  }
  .pet-avatar {
    appearance: none;
    position: absolute;
    inset: 0;
    display: block;
    width: 80px;
    height: 80px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: grab;
    pointer-events: auto;
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
